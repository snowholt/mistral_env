// Enhanced VS Code tasks for BeautyAI with icons and improved functionality
// - Added Unicode icons for better visual identification
// - Enhanced monitoring and analysis capabilities
// - Fixed background task handling issues
// NOTE: Comments are allowed in VS Code tasks.json
{
    "version": "2.0.0",
    "tasks": [
        // =============================
        // 🚀 SERVICE MANAGEMENT - API
        // =============================
        {
            "label": "🚀 Service: API - Start",
            "type": "shell",
            "command": "sudo systemctl start beautyai-api.service",
            "group": "build",
            "presentation": { 
                "reveal": "silent",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "🛑 Service: API - Stop",
            "type": "shell",
            "command": "sudo systemctl stop beautyai-api.service || true",
            "group": "build",
            "presentation": { 
                "reveal": "silent",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "📊 Service: API - Status",
            "type": "shell",
            "command": "sudo systemctl status beautyai-api.service --no-pager -l",
            "group": "test",
            "presentation": { 
                "reveal": "always", 
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "📝 Service: API - Journal (Follow)",
            "type": "shell",
            "command": "bash -c 'cd /home/lumi/beautyai && sudo journalctl -u beautyai-api.service -f --since=now 2>&1 | tee reports/logs/journal_backend_service.log'",
            "group": "test",
            "presentation": { 
                "reveal": "always", 
                "panel": "dedicated",
                "clear": true,
                "focus": false,
                "close": false
            },
            "problemMatcher": []
        },
        {
            "label": "📝 Service: PABX - Journal (Follow)",
            "type": "shell",
            "command": "bash -c 'cd /home/lumi/beautyai && sudo journalctl -u pabx-backend -f --since=now 2>&1 | tee pabx/logs/system/journal_pabx_backend.log'",
            "group": "test",
            "presentation": { 
                "reveal": "always", 
                "panel": "dedicated",
                "clear": true,
                "focus": false,
                "close": false
            },
            "problemMatcher": []
        },

        // =============================
        // 🌐 SERVICE MANAGEMENT - WEBUI
        // =============================
        {
            "label": "🚀 Service: WebUI - Start",
            "type": "shell",
