# ==============================================================================
# BeautyAI SaaS Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# Generate secrets with: openssl rand -hex 32
# ==============================================================================

# ==============================================================================
# CORE APPLICATION
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/beautyai/api.log

# Application URLs
APP_BASE_URL=https://gmai.sa
API_BASE_URL=https://api.gmai.sa
FRONTEND_URL=http://localhost:3000

# Environment: development, staging, production
ENVIRONMENT=production
DEBUG=0

# ==============================================================================
# DATABASE - PostgreSQL with pgvector
# ==============================================================================

# Async connection (for FastAPI)
DATABASE_URL=postgresql+asyncpg://beautyai:password@localhost:5432/beautyai
DATABASE_ECHO=false

# Sync connection (for Alembic migrations)
DATABASE_URL_SYNC=postgresql://beautyai:password@localhost:5432/beautyai

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==============================================================================
# REDIS - Caching and Rate Limiting
# ==============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Rate limiting (requests per window)
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================

# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-to-random-256-bit-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin domain (emails from this domain can be promoted to admin)
ADMIN_EMAIL_DOMAIN=gmai.sa

# ==============================================================================
# STRIPE - Payment Processing
# ==============================================================================

# Stripe API keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx

# Webhook secret (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe configuration
STRIPE_CURRENCY=sar
STRIPE_SUCCESS_URL=https://gmai.sa/app/billing?success=true
STRIPE_CANCEL_URL=https://gmai.sa/app/billing?canceled=true

# Use test mode (set to true for development)
STRIPE_DEV_MODE=false

# ==============================================================================
# ALIBABA DIRECTMAIL - Email Service
# ==============================================================================

# Alibaba Cloud credentials
ALICLOUD_ACCESS_KEY_ID=your_access_key_id
ALICLOUD_ACCESS_KEY_SECRET=your_access_key_secret

# DirectMail configuration (me-central-1 = Saudi Arabia)
DIRECTMAIL_REGION=me-central-1
DIRECTMAIL_SENDER=noreply@gmai.sa
DIRECTMAIL_SENDER_NAME=Genius AI

# ==============================================================================
# KNOWLEDGE BASE - RAG/Embeddings
# ==============================================================================

# Embedding model (sentence-transformers multilingual)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# Text chunking settings
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=200
KB_MIN_CHUNK_SIZE=100

# Search settings
KB_SEARCH_TOP_K=5
KB_SIMILARITY_THRESHOLD=0.5

# File upload directory
KB_UPLOAD_DIR=/var/lib/beautyai/uploads

# ==============================================================================
# WHATSAPP INTEGRATION (Meta Business API)
# ==============================================================================

WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_CONFIG_ID=YOUR_EMBEDDED_SIGNUP_CONFIG_ID

# Webhook verification token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=beautyai_webhook_verify_token

# OAuth redirect for Meta embedded signup
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/whatsapp/meta/callback

# ==============================================================================
# LLM INFERENCE
# ==============================================================================

# Local LLM API (self-reference)
LLM_API_URL=http://localhost:8000/inference/chat
LLM_MODEL_NAME=qwen3-unsloth-q4ks
LLM_PRESET=qwen_optimized

# Model paths
MODEL_PATH=/models/qwen3-unsloth-q4ks.gguf
WHISPER_MODEL=large-v3-turbo

# GPU settings
CUDA_VISIBLE_DEVICES=0
GPU_LAYERS=35

# AI behavior
AI_PAUSE_DURATION_MINUTES=30

# Skip model preloading for faster startup (useful for testing)
# SKIP_MODEL_PRELOAD=1

# ==============================================================================
# VOICE SERVICES
# ==============================================================================

VOICE_STREAMING_ENABLED=1
VOICE_STREAMING_PHASE4=1
VOICE_MINIMAL_MODE=1
VOICE_TRANSIENT_SUPPRESSOR=0
VOICE_DEBUG_CAPTURE=0

# WebRTC jitter buffer settings
AIORTC_AUDIO_JITTER_CAPACITY=128
AIORTC_AUDIO_JITTER_PREFETCH=50

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://gmai.sa,https://www.gmai.sa,http://localhost:3000,http://localhost:5173

# Set to 1 if reverse proxy (nginx) handles CORS headers
PROXY_HANDLES_CORS=0

# ==============================================================================
# SECURITY
# ==============================================================================

# Session cookie settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
