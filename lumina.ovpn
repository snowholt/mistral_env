client
dev tun
proto tcp
remote dev.gmai.sa 9000
resolv-retry infinite
nobind
persist-key
persist-tun
comp-lzo
verb 3

# Routes - only VPN subnet and server LAN
route-nopull
route 10.8.0.0 255.255.255.0
route 192.168.1.0 255.255.255.0

