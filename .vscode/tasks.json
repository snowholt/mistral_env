        {
            "label": "🧹 Utility: Clear All Logs",
            "type": "shell",
            "command": "cd /home/lumi/beautyai && rm -f logs/service/*.log logs/service/*.json backend/uvicorn.log && echo 'All logs cleared'",
            "group": "build",
            "presentation": { 
                "reveal": "silent",
                "showReuseMessage": false
