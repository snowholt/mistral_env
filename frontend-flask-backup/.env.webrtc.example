# WebRTC Frontend Environment Variables

# Feature Toggle
REACT_APP_VOICE_WEBRTC_ENABLED=false

# Utterance Configuration
REACT_APP_VOICE_WEBRTC_MAX_UTTERANCE_SEC=10

# Signaling Server (optional - defaults to same host)
# REACT_APP_VOICE_WEBRTC_SIGNALING_URL=https://dev.gmai.sa/api/v1/webrtc/voice

# Debug Options
REACT_APP_VOICE_WEBRTC_DEBUG=false

# ICE Configuration (advanced)
# Additional STUN/TURN servers can be configured in webrtc.config.js
