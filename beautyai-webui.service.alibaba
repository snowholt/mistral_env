[Unit]
Description=BeautyAI Web UI Service (Alibaba Cloud - Frontend)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/geniusai/geniusAI/mistral_env/frontend/src
ExecStart=/usr/bin/python3 /home/geniusai/geniusAI/mistral_env/frontend/src/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beautyai-webui-alibaba

# Environment variables
Environment=PYTHONPATH=/home/geniusai/geniusAI/mistral_env/frontend/src
Environment=PYTHONUNBUFFERED=1
Environment=FLASK_ENV=production

# BeautyAI specific configuration - WSS for production (Alibaba Cloud)
Environment=BEAUTYAI_ENABLE_SSL=auto
Environment=PORT=5001
Environment=BEAUTYAI_API_URL=http://localhost:8000
Environment=BEAUTYAI_WS_URL=wss://api.lumidev.ca/ws/voice-conversation
Environment=BEHIND_PROXY=true
Environment=USE_WSS=true

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
