            "problemMatcher": []
        },
        {
            "label": "🧹 Utility: Clear logs/ Directory (Keep Empty JSONL)",
            "type": "shell",
            "command": "cd /home/lumi/beautyai && find logs -type f -name '*.log' -delete && find logs -type f -name '*.jsonl' -exec truncate -s 0 {} \\; && echo '✅ logs/ cleared: .log files deleted, .jsonl files emptied'",
            "group": "build",
            "presentation": { 
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "📊 Utility: Show Log Files",
            "type": "shell",
            "command": "cd /home/lumi/beautyai && echo '=== Service Logs ===' && ls -la logs/service/ 2>/dev/null || echo 'No service logs found' && echo '=== Backend Logs ===' && ls -la backend/uvicorn.log backend/logs/ 2>/dev/null || echo 'No backend logs found'",
            "group": "test",
            "presentation": { 
                "reveal": "always", 
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
