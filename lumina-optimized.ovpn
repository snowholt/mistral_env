# ===========================================
# OPTIMIZED LOW-LATENCY OpenVPN CLIENT
# For development/testing - NOT for production!
# ===========================================

client
dev tun
proto tcp
remote dev.gmai.sa 9000
resolv-retry infinite
nobind
persist-key
persist-tun

# ===========================================
# PERFORMANCE OPTIMIZATIONS
# ===========================================

# Match server cipher - AES-128-GCM is fast with hardware acceleration
cipher AES-128-GCM

# Disable compression
allow-compression no

# Large buffers for better throughput
sndbuf 524288
rcvbuf 524288

# Verbosity
verb 3

# Routes - only VPN subnet and server LAN
route-nopull
route 10.8.0.0 255.255.255.0
route 192.168.1.0 255.255.255.0

