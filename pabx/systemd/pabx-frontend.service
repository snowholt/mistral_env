[Unit]
Description=BeautyAI PABX Frontend Development Server
After=network.target pabx-backend.service
Wants=pabx-backend.service
Documentation=file:///home/lumi/beautyai/pabx/ui/README.md

[Service]
Type=simple
User=lumi
Group=lumi
WorkingDirectory=/home/lumi/beautyai/pabx/ui
Environment="PATH=/usr/bin:/usr/local/bin:/bin"
Environment="NODE_ENV=development"
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pabx-frontend

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Performance settings
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
