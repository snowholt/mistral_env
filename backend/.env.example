# ===========================================
# BeautyAI Backend Environment Configuration
# ===========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===========================================
# WhatsApp Manager Configuration
# ===========================================

# PostgreSQL Database
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/whatsapp_saas
DATABASE_ECHO=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-to-random-256-bit-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Local LLM API (BeautyAI Inference - self-reference)
LLM_API_URL=http://localhost:8000/inference/chat
LLM_MODEL_NAME=qwen3-unsloth-q4ks
LLM_PRESET=qwen_optimized

# AI Behavior
AI_PAUSE_DURATION_MINUTES=30

# Meta/WhatsApp Configuration
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_CONFIG_ID=YOUR_EMBEDDED_SIGNUP_CONFIG_ID

# WhatsApp Webhook Verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN=beautyai_webhook_verify_token

# OAuth Redirect
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/whatsapp/meta/callback
FRONTEND_URL=http://localhost:3000

# ===========================================
# Model Configuration
# ===========================================

# Skip model preloading for faster startup (useful for testing)
# SKIP_MODEL_PRELOAD=1

# ===========================================
# CORS Configuration
# ===========================================

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Set to 1 if reverse proxy handles CORS
PROXY_HANDLES_CORS=0
