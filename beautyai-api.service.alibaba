[Unit]
Description=BeautyAI Inference API Server (Alibaba Cloud - Production with WebRTC)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/geniusai/geniusAI/mistral_env/backend

# Load environment variables from production file
EnvironmentFile=-/home/geniusai/geniusAI/mistral_env/.env.production

# Core environment settings
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
Environment=PYTHONPATH=/home/geniusai/geniusAI/mistral_env/backend
Environment=CUDA_VISIBLE_DEVICES=0
Environment=LD_LIBRARY_PATH=/home/geniusai/geniusAI/mistral_env/backend/venv/lib/python3.10/site-packages/nvidia/cuda_runtime/lib:/home/geniusai/geniusAI/mistral_env/backend/venv/lib/python3.10/site-packages/nvidia/cublas/lib:/home/geniusai/geniusAI/mistral_env/backend/venv/lib/python3.10/site-packages/nvidia/cudnn/lib

# Voice streaming configuration
Environment=VOICE_STREAMING_ENABLED=1
Environment=VOICE_STREAMING_PHASE4=1
Environment=VOICE_STREAMING_FORCE_REAL=1
Environment=VOICE_STREAMING_DISABLE_MOCK=1
Environment=VOICE_STREAMING_DECODE_INTERVAL_MS=240
Environment=VOICE_STREAMING_WINDOW_SECONDS=6.0
Environment=VOICE_STREAMING_MIN_SILENCE_MS=480
Environment=VOICE_STREAMING_TOKEN_STABLE_MS=480
Environment=VOICE_STREAMING_MAX_UTTERANCE_MS=10000
Environment=VOICE_STREAMING_MIN_EMIT_CHARS=1
Environment=VOICE_STREAMING_LENIENT_FINAL=1
Environment=VOICE_STREAMING_LENIENT_FINAL_DELAY_SEC=0.8
Environment=VOICE_STREAMING_FORCE_FINAL_AFTER_SEC=12
Environment=VOICE_STREAMING_LOW_LATENCY_PRESET=1
Environment=UVICORN_RELOAD=0

# ================================================================
# WebRTC Configuration (Phase F - Alibaba Cloud)
# ================================================================
# Maximum utterance duration in seconds (client-side: 10s, server-side: 10s)
Environment=VOICE_WEBRTC_MAX_UTTERANCE_SEC=10

# Enable aiortc debug logging for troubleshooting WebRTC issues
# Set to 1 for verbose WebRTC logs, 0 for production (less verbose)
Environment=VOICE_WEBRTC_DEBUG=0

# aiortc log level: DEBUG, INFO, WARNING, ERROR
# Use DEBUG for initial deployment, switch to WARNING for production
Environment=AIORTC_LOG_LEVEL=WARNING

# STUN server configuration (Google public STUN for MVP)
Environment=WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302

# Enable WebRTC feature flag (1 = enabled, 0 = WebSocket fallback only)
Environment=WEBRTC_ENABLED=1

# WebRTC connection timeout settings
Environment=WEBRTC_ICE_GATHERING_TIMEOUT=30
Environment=WEBRTC_CONNECTION_TIMEOUT=10

# WebRTC audio processing settings (inherited from Phase C config)
Environment=WEBRTC_AUDIO_SAMPLE_RATE=16000
Environment=WEBRTC_VAD_THRESHOLD_AR=0.45
Environment=WEBRTC_VAD_THRESHOLD_EN=0.50
# ================================================================

# CORS handled by FastAPI CORSMiddleware (nginx CORS headers disabled)
# Environment=PROXY_HANDLES_CORS=1

ExecStart=/home/geniusai/geniusAI/mistral_env/backend/venv/bin/python /home/geniusai/geniusAI/mistral_env/backend/run_server.py
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=5
Restart=on-failure
RestartSec=3

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/geniusai/geniusAI/mistral_env/backend
ReadWritePaths=/home/geniusai/geniusAI/mistral_env/sessions
ProtectHome=no

# Resource limits
LimitNOFILE=65536
MemoryMax=32G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beautyai-api-alibaba

[Install]
WantedBy=multi-user.target
