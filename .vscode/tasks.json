                "clear": true
            },
            "problemMatcher": []
        },

        // =============================
        // 🔧 DEV DIRECT RUN MODE
        // =============================
        {
            "label": "🔥 Dev: Run API (direct uvicorn script)",
            "type": "shell",
            "command": "cd /home/lumi/beautyai && source backend/venv/bin/activate && export VOICE_STREAMING_ENABLED=1 VOICE_STREAMING_PHASE4=1 VOICE_LANGGRAPH_ENABLED=1 && python backend/run_server.py",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { 
                "reveal": "always", 
                "panel": "dedicated", 
                "clear": true,
                "focus": true
            },
            "problemMatcher": "$python"
        },
        {
            "label": "🔪 Dev: Kill Direct API Processes",
            "type": "shell",
            "command": "pkill -f 'python backend/run_server.py' || echo 'No API processes found to kill'",
            "group": "build",
            "presentation": { 
                "reveal": "silent",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "🔬 Dev: Run API (MINIMAL MODE - 16kHz)",
            "type": "shell",
            "command": "cd /home/lumi/beautyai && source backend/venv/bin/activate && export VOICE_STREAMING_ENABLED=1 VOICE_STREAMING_PHASE4=1 VOICE_MINIMAL_MODE=1 && python backend/run_server.py",
            "group": "build",
            "presentation": { 
                "reveal": "always", 
                "panel": "dedicated", 
                "clear": true,
                "focus": true
            },
            "problemMatcher": "$python"
        },
        {
            "label": "📋 Dev: Tail Uvicorn Live (Direct Mode)",
            "type": "shell",
            "command": "timeout 300 tail -n 100 -f backend/uvicorn.log || echo 'Log tail stopped after 5 minutes'",
            "group": "test",
            "presentation": { 
                "reveal": "always", 
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "🧹 Dev: Clear Uvicorn Log File",
            "type": "shell",
            "command": "> backend/uvicorn.log && echo 'Uvicorn log file cleared'",
            "group": "build",
            "presentation": { 
                "reveal": "silent",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },

        // =============================
        // 🧪 STREAMING TESTS
        // =============================
        {
            "label": "🧪 Test: Streaming - Single PCM (Q1 Arabic)",
            "type": "shell",
            "command": "cd /home/lumi/beautyai && source backend/venv/bin/activate && python tests/streaming/ws_replay_pcm.py --file voice_tests/input_test_questions/pcm/q1.pcm --language ar --fast",
            "group": "test",
            "presentation": { 
                "reveal": "always", 
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$python"
        },
        {
            "label": "🧪 Test: Streaming - Pytest Suite",
            "type": "shell",
            "command": "cd /home/lumi/beautyai && source backend/venv/bin/activate && pytest -v tests/streaming/",
            "group": "test",
            "presentation": { 
                "reveal": "always", 
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$python",
                {
                    "owner": "pytest",
                    "pattern": {
                        "regexp": "^(.*):(\\d+): (.*)$",
                        "file": 1,
                        "line": 2,
                        "message": 3
                    }
                }
            ]
        },

        // =============================
        // 🔍 ENHANCED MONITORING & ANALYSIS
        // =============================
        {
            "label": "🔍 Monitor: Service Analysis (Quick)",
