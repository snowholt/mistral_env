# BeautyAI Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API Base URL (leave empty for same-origin, useful for development)
VITE_API_URL=

# Meta (Facebook) App Configuration for WhatsApp Embedded Signup
# Get these from https://developers.facebook.com/apps/
VITE_META_APP_ID=1438830807856481

# Optional: Sentry DSN for error tracking
VITE_SENTRY_DSN=

# Optional: Analytics
VITE_GA_TRACKING_ID=
